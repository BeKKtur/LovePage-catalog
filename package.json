{
  "name": "lovepage",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "predev": "node scripts/sync-preview-brand.mjs && node scripts/generate-previews.mjs",
